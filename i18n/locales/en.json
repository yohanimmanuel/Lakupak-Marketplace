  "support": {
    "helpCenter": {
      "title": "Help Center",
      "faqTitle": "Frequently Asked Questions",
      "done": "Done",
      "faqs": {
        "verifyPhone": {
          "q": "How do I verify my phone?",
          "a": "Choose WhatsApp or SMS in Sign Up, select your country code, enter your number, then tap \"Send code\". Enter the verification code to complete."
        },
        "googleLogin": {
          "q": "I can’t log in with Google",
          "a": "On web, you can pick a different account each time. If you still see an old session, sign out first and try again."
        },
        "whereIsMyOrder": {
          "q": "Where is my order?",
          "a": "Go to Account → My Purchases to view status: To Pay, To Ship, To Receive, Completed, Return/Refund, or Cancelled."
        },
        "walletRefunds": {
          "q": "Wallet and refunds",
          "a": "Refunds are returned to the original payment method or LakuPay depending on the channel and eligibility."
        },
        "contactSupport": {
          "q": "Contact support",
          "a": "For unresolved issues, contact us via support@laku.com. Provide your order ID and a brief description."
        }
      }
    },
    "returnRefundInfo": {
      "title": "Return & Refund Info",
      "cards": {
        "basicsTitle": "Return & refund basics",
        "basicsBody": "You can request a return for eligible items and get a refund after the request is approved and, when required, the items are received back in good condition.",
        "policyTitle": "Policy comes from product data",
        "policyBody1": "Each product has its own return policy stored in the product data. It defines whether it is returnable, how many days after delivery you can request a return, and any specific conditions.",
        "policyBody2": "Laku checks every return/refund request against this policy. Different items in the same order can therefore have different eligibility and refund amounts.",
        "policyStrong": "Refund approval and amount always depend on the return days and rules saved on each product, not only on the order status.",
        "quickFlowTitle": "Quick flow",
        "steps": {
          "1": "Check the product's return policy and time limit before buying a product.",
          "2": "Returns and refunds are only available when products have been delivered and received.",
          "3": "Start a return/refund request from order details.",
          "4": "Follow any instructions to send back the item with strong proof and evidence of return request.",
          "5": "Wait for review and refund to your payment method or wallet."
        }
      }
    },
    "orderHelpCenter": {
      "title": "Order Help Center",
      "overviewTitle": "Order help overview",
      "overviewBody": "This page gives a short guide for tracking your order and knowing who to contact. Any actions such as cancel, rate, or request return/refund are done in the main order details screen.",
      "orderId": "Order ID",
      "sections": {
        "deliveryStatusTitle": "See delivery status",
