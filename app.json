{
  "expo": {
    "name": "Laku",
    "slug": "laku-marketplace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/LakuLakuMobile.png",
    "scheme": "lakumarketplace",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/LakuLakuMobileSplash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a61d7"
    },
    "ios": {
      "bundleIdentifier": "com.laku.marketplace",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.laku.marketplace",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/LakuLakuMobile.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/LakuLakuMobile.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-font",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/LakuIconReal.png",
          "color": "#0a61d7",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b6b4fe3-0ab7-438b-aaed-477f75fb82e0"
      }
    }
  }
}
