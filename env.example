# =============================================================================
# Laku Marketplace (Expo) — environment variables
# Copy to `.env` in this folder. Restart Expo after changes.
#
# CI: GitHub Actions runs `npm ci` + `npm run ci:check` (lint + typecheck) on push.
# Typecheck runs `scripts/generate-expo-types.js` first (`.expo/types` is gitignored).
# Regenerate package-lock.json with npm 10 if `npm ci` fails on Linux: `npx npm@10.9.2 install`
#
# REQUIRED for production / EAS builds:
#   EXPO_PUBLIC_API_BASE_URL — your deployed Dashboard API (https://...)
#
# OPTIONAL (defaults or inferred in development):
#   EXPO_PUBLIC_ENV — development | staging | production
#   EXPO_PUBLIC_WS_PORT — WebSocket port (default 3001)
#   EXPO_PUBLIC_WS_URL — full WebSocket URL override
#   EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN — runtime maps + geocoding (public pk token)
#   MAPBOX_DOWNLOAD_TOKEN — native SDK download at build time (secret sk, DOWNLOADS:READ)
#   EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY — realtime
#   EXPO_PUBLIC_PROJECT_ID — Expo push notifications (or set in app.json eas.projectId)
# =============================================================================

# Local dev on a physical device: use your computer's LAN IP, not localhost
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.100:3000

EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_WS_PORT=3001

# EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-token

# MAPBOX_DOWNLOAD_TOKEN=sk.your-mapbox-download-token
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# EXPO_PUBLIC_PROJECT_ID=your-eas-project-id
